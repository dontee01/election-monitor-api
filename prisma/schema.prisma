// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(uuid())
  fullName    String
  email       String   @unique
  password    String
  role        Role @default(CITIZEN)
  refreshToken String?  // Optional field for storing refresh tokens

  reportedIncidents   Incident[] @relation("ReportedIncidents")
  verifiedIncidents   Incident[] @relation("VerifiedIncidents")
  uploadedMedia       Media[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?
}

enum Role {
  ADMIN
  AGENT
  CITIZEN
  OBSERVER
}

enum Visibility {
  PRIVATE
  PUBLIC
}

enum IncidentCategory {
  LOW_TURNOUT
  LATE_OPENING
  EARLY_CLOSURE
  MISSING_MATERIALS
  VIOLENCE
  INTIMIDATION
  VOTE_BUYING
  BALLOT_SNATCHING
  UNDERAGE_VOTING
  OVER_VOTING
  DEVICE_FAILURE
  SECURITY_ISSUE
  RESULT_TAMPERING
  OTHER
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  PENDING
  VERIFIED
  REJECTED
  RESOLVED
}

enum ElectionType {
  PRESIDENTIAL
  GOVERNORSHIP
  SENATORIAL
  HOUSE_OF_REPS
  STATE_ASSEMBLY
  LOCAL_GOVERNMENT
  BY_ELECTION
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

model State {
  id        String @id @default(uuid())
  name      String @unique
  code      String @unique
  lgas      Lga[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
}

model Lga {
  id        String @id @default(uuid())
  name      String
  stateId   String
  state     State @relation(fields: [stateId], references: [id], onDelete: Cascade)
  wards     Ward[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@unique([name, stateId])
}

model Ward {
  id        String @id @default(uuid())
  name      String
  lgaId     String
  lga       Lga @relation(fields: [lgaId], references: [id], onDelete: Cascade)
  pollingUnits PollingUnit[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@unique([name, lgaId])
}

model PollingUnit {
  id            String @id @default(uuid())
  code          String @unique
  name          String
  description   String?
  latitude      Decimal?
  longitude     Decimal?
  wardId        String
  ward          Ward @relation(fields: [wardId], references: [id], onDelete: Cascade)
  incidents     Incident[]
  results       ElectionResult[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
  createdBy     String?
  updatedBy     String?

  isActive Boolean @default(true)
  
  @@index([wardId])
  @@index([code])
}

