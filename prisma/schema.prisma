// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(uuid())
  fullName    String
  email       String   @unique
  password    String
  role        Role @default(CITIZEN)
  refreshToken String?  // Optional field for storing refresh tokens
  
  reportedIncidents   Incident[] @relation("ReportedIncidents")
  verifiedIncidents   Incident[] @relation("VerifiedIncidents")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
}

enum Role {
  ADMIN
  AGENT
  CITIZEN
  OBSERVER
}

enum IncidentCategory {
  LOW_TURNOUT
  LATE_OPENING
  NO_MATERIALS
  VIOLENCE
  BALLOT_SNATCHING
  INTIMIDATION
  OVER_VOTING
  MALFUNCTION
  VOTE_BUYING
  OTHER
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  PENDING
  VERIFIED
  REJECTED
  RESOLVED
}

model State {
  id        String @id @default(uuid())
  name      String @unique
  code      String @unique
  lgas      Lga[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
}

model Lga {
  id        String @id @default(uuid())
  name      String
  stateId   String
  state     State @relation(fields: [stateId], references: [id], onDelete: Cascade)
  wards     Ward[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@unique([name, stateId])
}

model Ward {
  id        String @id @default(uuid())
  name      String
  lgaId     String
  lga       Lga @relation(fields: [lgaId], references: [id], onDelete: Cascade)
  pollingUnits PollingUnit[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@unique([name, lgaId])
}

model PollingUnit {
  id            String @id @default(uuid())
  code          String @unique
  name          String
  description   String?
  latitude      Decimal?
  longitude     Decimal?
  wardId        String
  ward          Ward @relation(fields: [wardId], references: [id], onDelete: Cascade)
  incidents     Incident[]
  results       ElectionResult[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
  createdBy     String?
  updatedBy     String?

  isActive Boolean @default(true)
  
  @@index([wardId])
  @@index([code])
}

model Election {
  id          String   @id @default(uuid())
  name        String
  typeId      String
  type        ElectionType @relation(fields: [typeId], references: [id])
  electionDate DateTime
  isActive    Boolean  @default(false)

  incidents   Incident[]
  results     ElectionResult[]
}

model ElectionType {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  elections   Election[]
}

model ElectionResult {
  id            String   @id @default(uuid())
  pollingUnitId String
  pollingUnit   PollingUnit @relation(fields: [pollingUnitId], references: [id], onDelete: Cascade)
  electionId    String
  election      Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  candidateName String
  votes         Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
}

model Incident {
  id String @id @default(uuid())
  title String
  description String @db.Text
  category IncidentCategory
  severity Severity
  status IncidentStatus @default(PENDING)
  latitude Decimal?
  longitude Decimal?
  electionId String
  election Election @relation(fields: [electionId], references: [id])
  pollingUnitId String
  pollingUnit PollingUnit @relation(fields: [pollingUnitId], references: [id])

  reporterId String
  reporter User @relation("ReportedIncidents", fields: [reporterId], references: [id])
  media IncidentMedia[]

  verifiedById String?
  verifiedBy User? @relation("VerifiedIncidents", fields:[verifiedById], references:[id])
  verifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}

model IncidentMedia {
  id String @id @default(uuid())
  incidentId String
  incident Incident @relation(fields:[incidentId], references:[id], onDelete: Cascade)
  fileName String
  fileUrl String
  mimeType String
  size Int

  createdAt DateTime @default(now())
}