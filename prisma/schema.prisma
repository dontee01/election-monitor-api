// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  AGENT
  CITIZEN
  OBSERVER
}

enum Visibility {
  PRIVATE
  PUBLIC
}

enum IncidentDomain {
  COMMUNITY
  ELECTION
}

enum IncidentCategory {
  // COMMUNITY
  THEFT
  ROADBLOCK
  TRAFFIC
  RTA
  FIRE
  UTILITY_OUTAGE
  OTHER_COMMUNITY

  // ELECTION (existing — unchanged)
  LOW_TURNOUT
  LATE_OPENING
  EARLY_CLOSURE
  MISSING_MATERIALS
  VIOLENCE
  INTIMIDATION
  VOTE_BUYING
  BALLOT_SNATCHING
  UNDERAGE_VOTING
  OVER_VOTING
  DEVICE_FAILURE
  SECURITY_ISSUE
  RESULT_TAMPERING
  OTHER
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  PENDING
  VERIFIED
  REJECTED
  RESOLVED
}

enum ElectionType {
  PRESIDENTIAL
  GOVERNORSHIP
  SENATORIAL
  HOUSE_OF_REPS
  STATE_ASSEMBLY
  LOCAL_GOVERNMENT
  BY_ELECTION
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum ResultSubmissionStatus {
  SUBMITTED
  CORROBORATED  // matches ≥1 other submission
  DISPUTED      // conflicts with another submission
  OFFICIAL       // promoted into ElectionResult
}

model User {
  id          String   @id @default(uuid())
  fullName    String
  email       String   @unique
  password    String
  role        Role @default(CITIZEN)
  refreshToken String?  // Optional field for storing refresh tokens

  reportedIncidents   Incident[] @relation("ReportedIncidents")
  verifiedIncidents   Incident[] @relation("VerifiedIncidents")
  uploadedMedia       Media[]
  resultSubmissions   ElectionResultSubmission[]

  reportCount         Int @default(0)
  verifiedCount       Int @default(0)
  trustScore          Float @default(0.0)
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?
}

model State {
  id        String @id @default(uuid())
  name      String @unique
  code      String @unique
  lgas      Lga[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
}

model Lga {
  id        String @id @default(uuid())
  name      String
  stateId   String
  state     State @relation(fields: [stateId], references: [id], onDelete: Cascade)
  wards     Ward[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@unique([name, stateId])
}

model Ward {
  id        String @id @default(uuid())
  name      String
  lgaId     String
  lga       Lga @relation(fields: [lgaId], references: [id], onDelete: Cascade)
  pollingUnits PollingUnit[]
  incidents Incident[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@unique([name, lgaId])
}

model PollingUnit {
  id            String @id @default(uuid())
  code          String @unique
  name          String
  description   String?
  latitude      Decimal?
  longitude     Decimal?
  wardId        String
  ward          Ward @relation(fields: [wardId], references: [id], onDelete: Cascade)
  incidents     Incident[]
  resultSubmissions ElectionResultSubmission[]
  results       ElectionResult[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
  createdBy     String?
  updatedBy     String?

  isActive Boolean @default(true)
  
  @@index([wardId])
  @@index([code])
}

model Election {
  id            String   @id @default(uuid())
  name          String
  description   String?
  type          ElectionType
  electionDate  DateTime
  reference     String   @unique
  isActive      Boolean @default(false)
  incidents      Incident[]
  resultSubmissions ElectionResultSubmission[]
  results        ElectionResult[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ElectionResultSubmission {
  id            String   @id @default(uuid())
  electionId    String
  election      Election @relation(fields:[electionId], references:[id])
  pollingUnitId String
  pollingUnit   PollingUnit @relation(fields:[pollingUnitId], references:[id])

  submitterId   String
  submitter     User @relation(fields:[submitterId], references:[id])

  tallies         Json     // { candidateName: votes }
  resultSheetUrl  String   // photo of the physical form
  status          ResultSubmissionStatus @default(SUBMITTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pollingUnitId, electionId])
  @@index([status])
}

model ElectionResult {
  id            String   @id @default(uuid())
  pollingUnitId String
  pollingUnit   PollingUnit @relation(fields: [pollingUnitId], references: [id], onDelete: Cascade)
  electionId    String
  election      Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  candidateName String
  votes         Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
}

model Incident {
  id            String @id @default(uuid())
  reference     String   @unique
  domain        IncidentDomain @default(COMMUNITY)
  title         String
  description   String @db.Text
  category      IncidentCategory
  severity      Severity
  status        IncidentStatus @default(PENDING)
  visibility    Visibility @default(PRIVATE)

  occurredAt    DateTime?
  latitude      Decimal?
  longitude     Decimal?
  address       String?          // reverse-geocoded, for reports with no PU

  electionId    String?
  election      Election? @relation(fields:[electionId], references:[id])

  pollingUnitId String?
  pollingUnit   PollingUnit? @relation(fields:[pollingUnitId], references:[id])

  // NEW — lets a community report be Ward-level without a polling unit
  wardId        String?
  ward          Ward? @relation(fields:[wardId], references:[id])

  reporterId    String
  reporter      User @relation("ReportedIncidents", fields:[reporterId], references:[id])

  verifierId    String?
  verifier      User? @relation("VerifiedIncidents", fields:[verifierId], references:[id])

  media         Media[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([severity])
  @@index([pollingUnitId])
  @@index([wardId])
  @@index([reporterId])
  @@index([electionId])
  @@index([domain])
}

model Media {
  id            String    @id @default(uuid())
  reference     String    @unique
  type          MediaType
  url           String
  originalName  String
  mimeType      String
  extension     String
  fileSize      Int

  uploadedAt    DateTime @default(now())
  uploadedById  String
  uploadedBy    User @relation(fields: [uploadedById], references: [id])

  incidentId    String?
  incident      Incident? @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([incidentId])
  @@index([uploadedById])
}
