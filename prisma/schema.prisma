model Election {
  id            String   @id @default(uuid())
  name          String
  description   String?
  type          ElectionType
  electionDate  DateTime
  reference     String   @unique
  isActive      Boolean @default(false)
  incidents      Incident[]
  results        ElectionResult[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// model ElectionType {
//   id          String   @id @default(uuid())
//   name        String   @unique
//   description String?
//   elections   Election[]
// }

model ElectionResult {
  id            String   @id @default(uuid())
  pollingUnitId String
  pollingUnit   PollingUnit @relation(fields: [pollingUnitId], references: [id], onDelete: Cascade)
  electionId    String
  election      Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  candidateName String
  votes         Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
}

model Incident {
  id            String @id @default(uuid())
  reference     String   @unique
  title         String
  description   String @db.Text
  category      IncidentCategory
  severity      Severity
  status        IncidentStatus @default(PENDING)
  visibility    Visibility @default(PRIVATE)

  occurredAt    DateTime?
  latitude      Decimal?
  longitude     Decimal?

  electionId    String
  election      Election @relation(fields:[electionId], references:[id])

  pollingUnitId String
  pollingUnit   PollingUnit @relation(fields:[pollingUnitId], references:[id])

  reporterId    String
  reporter      User @relation("ReportedIncidents", fields:[reporterId], references:[id])

  verifierId    String?
  verifier      User? @relation("VerifiedIncidents", fields:[verifierId], references:[id])

  media         Media[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([severity])
  @@index([pollingUnitId])
  @@index([reporterId])
  @@index([electionId])
}

model Media {
  id            String    @id @default(uuid())
  reference     String    @unique
  type          MediaType
  url           String
  originalName  String
  mimeType      String
  extension     String
  fileSize      Int

  uploadedAt    DateTime @default(now())
  uploadedById  String
  uploadedBy    User @relation(fields: [uploadedById], references: [id])

  incidentId    String?
  incident      Incident? @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([incidentId])
  @@index([uploadedById])
}
