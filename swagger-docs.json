      "get": {
        "operationId": "IncidentsController_findAll",
        "parameters": [
          {
            "name": "page",
            "required": true,
            "in": "query",
            "description": "The page number for pagination (default is 1)",
            "schema": {
              "example": 1
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "The number of incidents to return per page (default is 20)",
            "schema": {
              "example": 20
            }
          },
          {
            "name": "search",
            "required": false,
            "in": "query",
            "description": "A search term to filter incidents by title or description",
            "schema": {
              "example": "search term",
              "type": "string"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "description": "Filter incidents by status",
            "schema": {
              "example": "PENDING",
              "type": "string",
              "enum": [
                "PENDING",
                "VERIFIED",
                "REJECTED",
                "RESOLVED"
              ]
            }
          },
          {
            "name": "severity",
            "required": false,
            "in": "query",
            "description": "Filter incidents by severity",
            "schema": {
              "example": "LOW",
              "type": "string",
              "enum": [
                "LOW",
                "MEDIUM",
                "HIGH",
                "CRITICAL"
              ]
            }
          },
          {
            "name": "category",
            "required": false,
            "in": "query",
            "description": "Filter incidents by category",
            "schema": {
              "example": "OTHER",
              "type": "string",
              "enum": [
                "THEFT",
                "ROADBLOCK",
                "TRAFFIC",
                "RTA",
                "FIRE",
                "UTILITY_OUTAGE",
                "OTHER_COMMUNITY",
                "LOW_TURNOUT",
                "LATE_OPENING",
                "EARLY_CLOSURE",
                "MISSING_MATERIALS",
                "VIOLENCE",
                "INTIMIDATION",
                "VOTE_BUYING",
                "BALLOT_SNATCHING",
                "UNDERAGE_VOTING",
                "OVER_VOTING",
                "DEVICE_FAILURE",
                "SECURITY_ISSUE",
                "RESULT_TAMPERING",
                "OTHER"
              ]
            }
          },
          {
            "name": "electionId",
            "required": false,
            "in": "query",
            "description": "Filter incidents by election ID",
            "schema": {
              "example": "uuid",
              "type": "string"
            }
          },
          {
            "name": "pollingUnitId",
            "required": false,
            "in": "query",
            "description": "Filter incidents by polling unit ID",
            "schema": {
              "example": "uuid",
              "type": "string"
            }
          },
          {
            "name": "reporterId",
            "required": false,
            "in": "query",
            "description": "Filter incidents by reporter ID",
            "schema": {
              "example": 1,
              "type": "number"
            }
          },
          {
            "name": "dateFrom",
            "required": false,
            "in": "query",
            "description": "The start date for the date range filter",
            "schema": {
              "format": "date-time",
              "example": "2026-10-07T04:50:41.183Z",
              "type": "string"
            }
          },
          {
            "name": "dateTo",
            "required": false,
            "in": "query",
            "description": "The end date for the date range filter",
            "schema": {
              "format": "date-time",
              "example": "2026-10-07T04:50:41.184Z",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "Incidents"
        ]
      }
    },
